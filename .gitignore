.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
test-results/
pytestdebug.log
.hypothesis/
.tox/
.nox/

# Linters and type checkers
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Profiling output
*.prof

# Docs builds
docs/_build/
/site

# Jupyter
.ipynb_checkpoints/

