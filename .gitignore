# Python bytecode and native extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Build and packaging artifacts (`uv build` writes to dist/)
build/
dist/
wheels/
sdist/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Virtual environments (`uv sync` creates .venv/). uv.lock is committed.
.venv/
venv/
env/
.env

# Local Python version pin (`uv python pin`); CI tests a version matrix
.python-version

